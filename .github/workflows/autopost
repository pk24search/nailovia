name: Auto Blogger Post

on:
  schedule:
    - cron: '0 */3 * * *'
  workflow_dispatch:

jobs:
  run-bot:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    
    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Setup Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install Libraries
      run: |
        python -m pip install --upgrade pip
        pip install feedparser beautifulsoup4 google-api-python-client google-auth-httplib2 google-auth-oauthlib requests

    - name: Run Auto Blogger Script
      env:
        GEMINI_API_KEYS: ${{ secrets.GEMINI_API_KEYS }}
        GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        CLIENT_ID: ${{ secrets.CLIENT_ID }}
        CLIENT_SECRET: ${{ secrets.CLIENT_SECRET }}
        REFRESH_TOKEN: ${{ secrets.REFRESH_TOKEN }}
        BLOG_ID: ${{ secrets.BLOG_ID }}
        BLOG_URL: ${{ secrets.BLOG_URL }}
      run: python nail_art_auto_poster.py

    - name: Commit posted files
      run: |
        git config --global user.name "github-actions"
        git config --global user.email "actions@github.com"
        git add posted_urls.txt posted_titles.txt posted_images.txt posted_hashes.txt
        git commit -m "Update posted data" || exit 0
        git push
